# Copier ce fichier en .env puis remplir les valeurs. Ne jamais commiter .env.

# Serveur
PORT=
NODE_ENV=
# Adresse du frontend autorisée à appeler l'API (ex : http://localhost:5173)
CORS_ORIGIN=

# Supabase (Project Settings > API)
SUPABASE_URL=
# Clé secrète : uniquement côté serveur, jamais dans le frontend
SUPABASE_SERVICE_ROLE_KEY=

# JWT : secret long et aleatoire (node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Paiement Moneroo (facultatif au démarrage ; sans ces valeurs, le paiement en ligne répond « pas encore disponible »)
# Clé secrète : tableau de bord Moneroo > Développeurs. Uniquement côté serveur.
MONEROO_SECRET_KEY=
# Secret du webhook : choisi par toi, le même ici et dans Moneroo > Développeurs > Webhooks (« Hash secret »)
# Adresse du webhook à saisir dans Moneroo : <adresse du backend>/api/public/payments/webhook
MONEROO_WEBHOOK_SECRET=
# Devise des paiements (code ISO), ex : XOF
PAYMENT_CURRENCY=XOF
# Tests en sandbox seulement : méthodes imposées à la place de celles du pays (séparées par des virgules).
# Passerelle de test Moneroo : MONEROO_TEST_METHODS=moneroo_payment_demo avec PAYMENT_CURRENCY=USD,
# numéro 4149518161 = paiement réussi. À laisser VIDE en production.
MONEROO_TEST_METHODS=
# Adresse publique du site client, sans / final : retour après paiement (/merci?pid=...)
FRONTEND_URL=https://monwifizone.org
